# Cloud Build receives only the application source required by Dockerfile.
.gcloudignore
.git
.gitignore
.github
.agents
.claude
.codex
.pnpm-store
node_modules
/dist/
/dist-web/
/coverage/
/playwright-report/
/test-results/
/tmp/

# Local configuration and credentials.
.env
.env.*
*.log
*.pid

# Reference/licensed source material and generated datasets are never build context,
# except the synthetic HRMS staff directory the mock HRMS adapter reads at runtime.
/data/*
!/data/generated
/data/generated/*
!/data/generated/ist_qatar_seed_data.json
/New folder/
*.pdf
*.docx
*.zip

# Local design/reference workspaces not needed by the runtime image.
/remix_-ist-technologies/
/interactive dashboard style click on enable .html

# The production Dockerfile does not consume these development assets,
# except the licensed STCC content file the runtime reads eagerly at startup.
/design/
/docs/*
!/docs/protocol-review/
/docs/protocol-review/*
!/docs/protocol-review/data/
/docs/protocol-review/data/*
!/docs/protocol-review/data/abdominal-pain-male.db.json
/python/
/scripts/
/tests/
/docker-compose.yml
/jest.config.cjs
/playwright.config.ts
/tsconfig.test.json
/README.md
