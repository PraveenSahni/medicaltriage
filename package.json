{
  "name": "ist-qatar-tele-triage-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rules-first AI tele-triage MVP scaffold for IST Qatar Group Health & Medical Services.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:api": "tsx src/index.ts",
    "dev:web": "vite --host 127.0.0.1 --config frontend/vite.config.ts",
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config frontend/vite.config.ts",
    "preview:web": "vite preview --host 127.0.0.1 --config frontend/vite.config.ts",
    "typecheck:web": "tsc -p frontend/tsconfig.json --noEmit",
    "content:dry-run": "tsx src/scripts/importClinicalContent.ts --dry-run",
    "content:import": "tsx src/scripts/importClinicalContent.ts",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.6",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
