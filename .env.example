DATABASE_URL="postgresql://triage_user:triage_password@localhost:5432/ist_triage?schema=public"
PORT=8080
NODE_ENV=development
GCP_REGION=me-central1
CLINICAL_CONTENT_SOURCE_URI="embedded:samplePhase1ClinicalContent"

# Oracle Fusion HCM connector target. Store real credentials in GCP Secret Manager.
ORACLE_HCM_BASE_URL="https://example.fa.oraclecloud.com"
ORACLE_HCM_API_VERSION=11.13.18.05
ORACLE_HCM_AUTH_MODE=oauth2
ORACLE_HCM_READONLY=true
ORACLE_HCM_CACHE_TTL_SECONDS=300
ORACLE_HCM_CONNECT_TIMEOUT_MS=5000
ORACLE_HCM_TOKEN_SECRET_NAME="oracle-hcm-oauth-token"
ORACLE_HCM_USERNAME_SECRET_NAME="oracle-hcm-username"
ORACLE_HCM_PASSWORD_SECRET_NAME="oracle-hcm-password"

# Security, authentication, and privacy administration
AUTH_SESSION_COOKIE_NAME="ist_triage_session"
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_MAX_DURATION_SECONDS=28800
AUTH_LOCAL_LOGIN_ENABLED=true
AUTH_PASSWORD_HASH_ALGORITHM="argon2id"
AUTH_REQUIRE_MFA_FOR_REVEAL=true
AUTH_SSO_DEFAULT_PROVIDER="entra-qa"
AUTH_SSO_CLIENT_SECRET_NAME="triage-sso-client-secret"
AUTH_SSO_METADATA_SECRET_NAME="triage-sso-metadata"
KMS_PROVIDER="gcp-kms"
KMS_REGION="me-central1"
KMS_PERSONAL_DATA_KEY_ALIAS="projects/PROJECT_ID/locations/me-central1/keyRings/triage/cryptoKeys/personal-data"
KMS_HEALTH_DATA_KEY_ALIAS="projects/PROJECT_ID/locations/me-central1/keyRings/triage/cryptoKeys/health-data"
AUDIT_EVENT_RETENTION_DAYS=2555
PERSONAL_DATA_REVEAL_SECONDS=60
