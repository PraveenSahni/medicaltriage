DATABASE_URL="postgresql://triage_user:triage_password@localhost:5432/ist_triage?schema=public"
MOCK_MODE=true
PORT=8080
NODE_ENV=development
GCP_REGION=me-central1
CLINICAL_CONTENT_SOURCE_URI="embedded:samplePhase1ClinicalContent"

# Environment banner shown in the login page and authenticated shell.
# Use APP_ENVIRONMENT=simulation for synthetic-data rehearsals and APP_ENVIRONMENT=demo for curated customer demos.
APP_ENVIRONMENT=simulation
APP_DATA_PROFILE=synthetic
APP_ENVIRONMENT_BANNER_VISIBLE=true
APP_ENVIRONMENT_LABEL="SIMULATION"
APP_ENVIRONMENT_DESCRIPTION="Synthetic records only. No PHI. Use for workflow rehearsal, AI evaluation, and governed model testing."

# Local PostgreSQL Docker Compose defaults. Change these before shared UAT use.
POSTGRES_USER=triage_user
POSTGRES_PASSWORD=triage_password
POSTGRES_DB=ist_triage
POSTGRES_PORT=5432

# CCP communication transport. Dry-run is the safe default for demos and local work.
CCP_TRANSPORT_MODE=dry-run
CCP_TEST_REDIRECT_TO=""
CCP_TEST_REDIRECT_PHONE=""
CCP_TEST_REDIRECT_EMAIL=""
CCP_ALLOW_UNSIGNED_WEBHOOKS=false

# WhatsApp / SMS adapter target. Store real credentials in GCP Secret Manager.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_SMS_FROM=""
TWILIO_WEBHOOK_PUBLIC_URL="https://example.run.app/api/v1/ccp/webhooks/twilio"

# Microsoft 365 Graph email adapter target. Store real credentials in GCP Secret Manager.
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
EMAIL_FROM=""

# Oracle Fusion HCM connector target. Store real credentials in GCP Secret Manager.
ORACLE_HCM_BASE_URL="https://example.fa.oraclecloud.com"
ORACLE_HCM_API_VERSION=11.13.18.05
ORACLE_HCM_AUTH_MODE=oauth2
ORACLE_HCM_READONLY=true
ORACLE_HCM_CACHE_TTL_SECONDS=300
ORACLE_HCM_CONNECT_TIMEOUT_MS=5000
ORACLE_HCM_TOKEN_SECRET_NAME="oracle-hcm-oauth-token"
ORACLE_HCM_USERNAME_SECRET_NAME="oracle-hcm-username"
ORACLE_HCM_PASSWORD_SECRET_NAME="oracle-hcm-password"

# EMR / FHIR writeback. Keep FHIR_WRITEBACK_MODE=dry-run until clinical,
# privacy, and integration governance approve live DocumentReference posting.
FHIR_WRITEBACK_MODE=dry-run
FHIR_BASE_URL="https://example-emr.local/fhir"
EMR_BASE_URL="https://example-emr.local/fhir"
ORACLE_HEALTH_BASE_URL=""
HMC_CERNER_FHIR_BASE_URL=""
PHCC_CERNER_FHIR_BASE_URL=""
CERNER_FHIR_BASE_URL=""
SIDRA_EPIC_FHIR_BASE_URL=""
EPIC_FHIR_BASE_URL=""
FHIR_ACCESS_TOKEN=""
CERNER_FHIR_ACCESS_TOKEN=""
EPIC_FHIR_ACCESS_TOKEN=""
FHIR_PRACTITIONER_ID=""
FHIR_TEST_PATIENT_QID=""
FHIR_TEST_PATIENT_ID=""
QHIE_BASE_URL="https://example-qhie.local/fhir"
QHIE_FHIR_BASE_URL=""
QHIE_ACCESS_TOKEN=""

# Security, authentication, and privacy administration
ADMIN_PASSWORD="LocalMockAdmin!2026"
VITE_DEMO_ADMIN_PASSWORD="LocalMockAdmin!2026"
AUTH_SESSION_COOKIE_NAME="ist_triage_session"
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_MAX_DURATION_SECONDS=28800
AUTH_LOCAL_LOGIN_ENABLED=true
AUTH_PASSWORD_HASH_ALGORITHM="argon2id"
AUTH_REQUIRE_MFA_FOR_REVEAL=true
AUTH_SSO_DEFAULT_PROVIDER="entra-qa"
AUTH_SSO_CLIENT_SECRET_NAME="triage-sso-client-secret"
AUTH_SSO_METADATA_SECRET_NAME="triage-sso-metadata"
KMS_PROVIDER="gcp-kms"
KMS_REGION="me-central1"
KMS_PERSONAL_DATA_KEY_ALIAS="projects/PROJECT_ID/locations/me-central1/keyRings/triage/cryptoKeys/personal-data"
KMS_HEALTH_DATA_KEY_ALIAS="projects/PROJECT_ID/locations/me-central1/keyRings/triage/cryptoKeys/health-data"
AUDIT_EVENT_RETENTION_DAYS=2555
PERSONAL_DATA_REVEAL_SECONDS=60

# Help & Library restricted vault (secondary access, metadata-only content -
# see src/services/helpRestrictedAccess.ts). Generate the hash offline with
# `tsx src/scripts/hashHelpRestrictedPassword.ts "<password>"` and store both
# values in your deployment's secret manager - never commit real values here.
HELP_RESTRICTED_ACCESS_PASSWORD_HASH=""
HELP_RESTRICTED_SESSION_SECRET=""
# Production Cloud Run services must set every dedicated persistence flag to
# true. The application fails startup under NODE_ENV=production if any are
# missing, preventing process-local security state in a multi-instance service.
QUEUE_DB_PERSISTENCE=false
SESSION_DB_PERSISTENCE=false
MFA_DB_PERSISTENCE=false
AUDIT_EVENT_DB_PERSISTENCE=false
# Production-only connection for the insert/select-only audit-ledger DB role.
AUDIT_DATABASE_URL=""
AUDIT_HMAC_KEY_VERSION=v1
# Optional JSON map of retained historical key versions for chain verification.
AUDIT_HMAC_KEYS_JSON=""
ROLE_PERMISSION_DB_PERSISTENCE=false
ROLE_CATALOG_REFRESH_SECONDS=30
REVEAL_WORKFLOW_DB_PERSISTENCE=false
REVEAL_ANOMALY_DB_PERSISTENCE=false
SECURITY_ANOMALY_DB_PERSISTENCE=false
