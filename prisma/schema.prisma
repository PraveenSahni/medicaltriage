generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Clinical acuity floor returned by the deterministic triage engine.
enum TriageSeverity {
  EMERGENCY
  URGENT
  ROUTINE
  SELF_CARE
}

/// Localized disposition target used after the rules engine has set the safety floor.
enum AcuityDispositionCode {
  SIDRA_PEDIATRIC_ED
  HMC_EMERGENCY_DEPARTMENT
  HMC_URGENT_REVIEW
  IST_HIA_MIDFIELD_MEDICAL_CENTRE
  IST_OLD_AIRPORT_MEDICAL_COMMISSION
  PHCC_URGENT_CARE_OR_TELECONSULT
  OUTSTATION_TELECONSULT_ESCALATION
  SELF_CARE_WITH_CALLBACK_PRECAUTIONS
}

enum BiologicalSex {
  FEMALE
  MALE
  OTHER
  UNKNOWN
}

enum DutyStatus {
  ACTIVE
  ON_LEAVE
  REST_PERIOD
  SUSPENDED
  INACTIVE
}

enum DependentRelationship {
  SPOUSE
  SON
  DAUGHTER
  CHILD
  PARENT
  OTHER
}

enum InsuranceEligibilityStatus {
  ELIGIBLE
  SUSPENDED
  INELIGIBLE
  PENDING_VERIFICATION
  UNKNOWN
}

enum OverrideStatusFlag {
  AI_RECOMMENDATION_DIFFERED
  NURSE_OVERRIDE_UP
  NURSE_OVERRIDE_DOWN_BLOCKED
  RULES_ENGINE_FINAL
  REVIEW_REQUIRED
}

enum ProtocolMode {
  OFFICE_HOURS
  AFTER_HOURS
  BOTH
}

enum ClinicalContentSourceType {
  SYNTHETIC_SAMPLE
  LICENSED_STCC
  LOCAL_QATAR_OVERRIDE
}

enum ClinicalContentImportStatus {
  PENDING
  VALIDATED
  IMPORTED
  FAILED
}

model ProtocolRelease {
  id              String                      @id @default(cuid())
  name            String
  version         String
  sourceType      ClinicalContentSourceType   @map("source_type")
  region          String                      @default("QA")
  mode            ProtocolMode                @default(BOTH)
  active          Boolean                     @default(false)
  importedAt      DateTime?                   @map("imported_at")
  algorithms      Algorithm[]
  importJobs      ClinicalContentImportJob[]
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  @@unique([sourceType, version])
  @@index([region, active])
  @@map("protocol_releases")
}

model Algorithm {
  id                   String             @id @default(cuid())
  releaseId            String?            @map("release_id")
  release              ProtocolRelease?   @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  externalProtocolId   String?            @unique @map("external_protocol_id")
  mode                 ProtocolMode       @default(BOTH)
  titleEn              String             @map("title_en")
  titleAr              String?            @map("title_ar")
  clinicalDefinitionEn String?            @map("clinical_definition_en")
  clinicalDefinitionAr String?            @map("clinical_definition_ar")
  backgroundInfoEn     String?            @map("background_info_en")
  backgroundInfoAr     String?            @map("background_info_ar")
  genderRestriction    BiologicalSex?     @map("gender_restriction")
  ageMin               Int?               @map("age_min")
  ageMax               Int?               @map("age_max")
  stccVersion          String?            @map("stcc_version")
  active               Boolean            @default(true)
  questions            TriageQuestion[]
  careAdviceLinks      AlgorithmCareAdvice[]
  keywordIndexes       ProtocolKeywordIndex[]
  synonyms             ProtocolSynonym[]
  dispositionMaps      ProtocolDispositionMap[]
  encounters           AviationTriageEncounter[]
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@index([titleEn])
  @@index([releaseId, active])
  @@index([mode])
  @@map("algorithms")
}

model TriageQuestion {
  id                    String                @id @default(cuid())
  algorithmId           String                @map("algorithm_id")
  algorithm             Algorithm             @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  externalQuestionId     String?               @map("external_question_id")
  acuityOrder           Int                   @map("acuity_order")
  severityGrade         TriageSeverity        @map("severity_grade")
  questionTextEn        String                @map("question_text_en")
  questionTextAr        String?               @map("question_text_ar")
  acuityDispositionCode AcuityDispositionCode @map("acuity_disposition_code")
  rationaleEn           String?               @map("rationale_en")
  redFlag               Boolean               @default(false) @map("red_flag")
  branching             Json?                 @map("branching")
  careAdviceLinks        QuestionAdviceBridge[]
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@index([algorithmId, acuityOrder])
  @@index([externalQuestionId])
  @@map("triage_questions")
}

model CareAdvice {
  id                String                @id @default(cuid())
  externalCareAdviceId String?            @unique @map("external_care_advice_id")
  adviceTitleEn     String                @map("advice_title_en")
  adviceTitleAr     String?               @map("advice_title_ar")
  instructionTextEn String                @map("instruction_text_en")
  instructionTextAr String?               @map("instruction_text_ar")
  dispositionCode   AcuityDispositionCode? @map("disposition_code")
  warningSigns      Json?                 @map("warning_signs")
  algorithmLinks    AlgorithmCareAdvice[]
  questionLinks     QuestionAdviceBridge[]
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@map("care_advice")
}

model AlgorithmCareAdvice {
  algorithmId String    @map("algorithm_id")
  careAdviceId String   @map("care_advice_id")
  algorithm   Algorithm @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  careAdvice  CareAdvice @relation(fields: [careAdviceId], references: [id], onDelete: Cascade)

  @@id([algorithmId, careAdviceId])
  @@map("algorithm_care_advice")
}

/// Bridge between a positive triage question and targeted care advice.
/// This is intentionally named close to the Phase I manual's
/// Question_Advice_Bridge contract so licensed STCC/Schmitt-Thompson imports can
/// map the same relationship without touching backend triage logic.
model QuestionAdviceBridge {
  questionId   String         @map("question_id")
  adviceId     String         @map("advice_id")
  triggerAnswer String        @default("YES") @map("trigger_answer")
  question     TriageQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  advice       CareAdvice     @relation(fields: [adviceId], references: [id], onDelete: Cascade)

  @@id([questionId, adviceId, triggerAnswer])
  @@map("question_advice_bridge")
}

model ProtocolKeywordIndex {
  id               String    @id @default(cuid())
  algorithmId      String    @map("algorithm_id")
  algorithm        Algorithm @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  phrase           String
  normalizedPhrase String    @map("normalized_phrase")
  language         String    @default("en")
  weight           Int       @default(50)
  source           String    @default("release")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([normalizedPhrase])
  @@index([algorithmId, weight])
  @@map("protocol_keyword_indexes")
}

model ProtocolSynonym {
  id             String     @id @default(cuid())
  algorithmId    String?    @map("algorithm_id")
  algorithm      Algorithm? @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  canonicalTerm  String     @map("canonical_term")
  synonym        String
  language       String     @default("en")
  region         String     @default("QA")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([canonicalTerm, synonym])
  @@map("protocol_synonyms")
}

model ProtocolDispositionMap {
  id                 String                @id @default(cuid())
  algorithmId         String?               @map("algorithm_id")
  algorithm           Algorithm?            @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  severity            TriageSeverity
  dispositionCode     AcuityDispositionCode @map("disposition_code")
  ageMin              Int?                  @map("age_min")
  ageMax              Int?                  @map("age_max")
  aviationContext     Json?                 @map("aviation_context")
  routeLabelEn        String                @map("route_label_en")
  routeLabelAr        String?               @map("route_label_ar")
  routeRationaleEn    String                @map("route_rationale_en")
  routeRationaleAr    String?               @map("route_rationale_ar")
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@index([severity, dispositionCode])
  @@index([algorithmId, active])
  @@map("protocol_disposition_maps")
}

model LocalizedDisposition {
  id                  String                @id @default(cuid())
  code                AcuityDispositionCode @unique
  destinationNameEn   String                @map("destination_name_en")
  destinationNameAr   String?               @map("destination_name_ar")
  routingNotesEn      String                @map("routing_notes_en")
  routingNotesAr      String?               @map("routing_notes_ar")
  region              String                @default("QA")
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@index([region, active])
  @@map("localized_dispositions")
}

model ClinicalContentImportJob {
  id              String                       @id @default(cuid())
  releaseId       String?                      @map("release_id")
  release         ProtocolRelease?             @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  sourceUri       String                       @map("source_uri")
  sourceChecksum  String?                      @map("source_checksum")
  status          ClinicalContentImportStatus  @default(PENDING)
  importerVersion String                       @default("phase1-importer") @map("importer_version")
  rowsRead        Int                          @default(0) @map("rows_read")
  rowsInserted    Int                          @default(0) @map("rows_inserted")
  rowsSkipped     Int                          @default(0) @map("rows_skipped")
  errorCount      Int                          @default(0) @map("error_count")
  startedAt       DateTime                     @default(now()) @map("started_at")
  finishedAt      DateTime?                    @map("finished_at")
  errors          ClinicalContentImportError[]

  @@index([status, startedAt])
  @@map("clinical_content_import_jobs")
}

model ClinicalContentImportError {
  id             String                   @id @default(cuid())
  importJobId    String                   @map("import_job_id")
  importJob      ClinicalContentImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  sourceRecordId String?                  @map("source_record_id")
  tableName      String?                  @map("table_name")
  message        String
  severity       String                   @default("error")
  createdAt      DateTime                 @default(now()) @map("created_at")

  @@index([importJobId])
  @@map("clinical_content_import_errors")
}

model StaffMember {
  id                         String                     @id @default(cuid())
  istStaffId                 String                     @unique @map("ist_staff_id")
  department                 String
  jobTitle                   String                     @map("job_title")
  dutyStatus                 DutyStatus                 @default(ACTIVE) @map("duty_status")
  insuranceProvider          String?                    @map("insurance_provider")
  insuranceEligibilityStatus InsuranceEligibilityStatus @default(UNKNOWN) @map("insurance_eligibility_status")
  insuranceLastChecked       DateTime?                  @map("insurance_last_checked")
  dateOfBirth                DateTime?                  @map("date_of_birth")
  dependents                 Dependent[]
  encounters                 AviationTriageEncounter[]
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")

  @@index([department])
  @@map("staff_members")
}

model Dependent {
  id              String                  @id @default(cuid())
  staffMemberId   String                  @map("staff_member_id")
  staffMember     StaffMember             @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  fullName        String                  @map("full_name")
  relationshipType DependentRelationship  @map("relationship")
  age             Int
  dateOfBirth      DateTime?               @map("date_of_birth")
  biologicalSex   BiologicalSex           @map("biological_sex")
  encounters      AviationTriageEncounter[]
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([staffMemberId])
  @@map("dependents")
}

model AviationTriageEncounter {
  id                     String                  @id @default(cuid())
  staffMemberId           String                  @map("staff_member_id")
  staffMember             StaffMember             @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  dependentId             String?                 @map("dependent_id")
  dependent               Dependent?              @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  protocolUsedId          String?                 @map("protocol_used_id")
  protocolUsed            Algorithm?              @relation(fields: [protocolUsedId], references: [id], onDelete: SetNull)
  initialAcuityScore      Int                     @map("initial_acuity_score")
  finalDispositionCode    AcuityDispositionCode   @map("final_disposition_code")
  audioRecordingUrl       String?                 @map("audio_recording_url")
  transcriptText          String?                 @map("transcript_text")
  transcriptLanguage      String?                 @map("transcript_language")
  customAviationTags      Json?                   @map("custom_aviation_tags")
  clipboardPayload        Json?                   @map("clipboard_payload")
  nurseId                 String                  @map("nurse_id")
  completedAt             DateTime?               @map("completed_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  safetyLog               SafetyAuditDeviationLog?

  @@index([staffMemberId, createdAt])
  @@index([finalDispositionCode])
  @@map("aviation_triage_encounters")
}

model SafetyAuditDeviationLog {
  id                       String             @id @default(cuid())
  encounterId               String             @unique @map("encounter_id")
  encounter                 AviationTriageEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  originalAiRecommendation  String             @map("original_ai_recommendation")
  nurseOverrideRationale    String?            @map("nurse_override_rationale")
  rulesEngineSeverity       TriageSeverity     @map("rules_engine_severity")
  overrideStatusFlag        OverrideStatusFlag @map("override_status_flag")
  isCriticalFloorBreach     Boolean            @default(false) @map("is_critical_floor_breach")
  explainabilityTrace       Json               @map("explainability_trace")
  createdAt                 DateTime           @default(now()) @map("created_at")

  @@index([overrideStatusFlag, createdAt])
  @@index([isCriticalFloorBreach, createdAt])
  @@map("safety_audit_deviation_logs")
}

model ApplicationUser {
  id                    String   @id @default(cuid())
  employeeId            String?  @unique @map("employee_id")
  hrmsId                String?  @unique @map("hrms_id")
  fullName              String   @map("full_name")
  emailCiphertext       String?  @map("email_ciphertext")
  emailBlindIndex       String?  @unique @map("email_blind_index")
  mobileCiphertext      String?  @map("mobile_ciphertext")
  mobileBlindIndex      String?  @map("mobile_blind_index")
  organization          String   @default("IST Tech")
  facility              String?
  department            String?
  clinicalSpecialty     String?  @map("clinical_specialty")
  jobTitle              String?  @map("job_title")
  professionalCategory  String?  @map("professional_category")
  managerUserId         String?  @map("manager_user_id")
  licenceNumberCiphertext String? @map("licence_number_ciphertext")
  licenceAuthority      String?  @map("licence_authority")
  licenceExpiry         DateTime? @map("licence_expiry")
  country               String   @default("QA")
  preferredLanguage     String   @default("en") @map("preferred_language")
  timeZone              String   @default("Asia/Qatar") @map("time_zone")
  authenticationMethod  String   @default("local") @map("authentication_method")
  mfaStatus             String   @default("pending") @map("mfa_status")
  accountStatus         String   @default("active") @map("account_status")
  createdBy             String?  @map("created_by")
  updatedBy             String?  @map("updated_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([organization, facility, department])
  @@index([accountStatus])
  @@map("application_users")
}

model Role {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String?
  status           String   @default("active")
  requiresApproval Boolean  @default(true) @map("requires_approval")
  version          String   @default("1.0")
  createdBy        String?  @map("created_by")
  updatedBy        String?  @map("updated_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Responsibility {
  id                          String   @id @default(cuid())
  code                        String   @unique
  name                        String
  description                 String?
  module                      String
  businessFunction            String   @map("business_function")
  riskClassification          String   @map("risk_classification")
  clinicalOrAdministrative    String   @map("clinical_or_administrative")
  allowedActions              Json     @map("allowed_actions")
  dataScope                   Json?    @map("data_scope")
  clinicalScope               Json?    @map("clinical_scope")
  integrationScope            Json?    @map("integration_scope")
  prerequisiteResponsibilities Json?   @map("prerequisite_responsibilities")
  conflictingResponsibilities Json?    @map("conflicting_responsibilities")
  approvalRequirement         String   @default("approval_required") @map("approval_requirement")
  effectiveDate               DateTime? @map("effective_date")
  expiryDate                  DateTime? @map("expiry_date")
  status                      String   @default("active")
  version                     String   @default("1.0")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@index([module, status])
  @@map("responsibilities")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  action      String
  description String?
  risk        String   @default("medium")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([module, action])
  @@map("permissions")
}

model AccessProfile {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  description        String?
  organizationScope  Json?    @map("organization_scope")
  facilityScope      Json?    @map("facility_scope")
  departmentScope    Json?    @map("department_scope")
  specialtyScope     Json?    @map("specialty_scope")
  queueScope         Json?    @map("queue_scope")
  shiftRestrictions  Json?    @map("shift_restrictions")
  status             String   @default("active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("access_profiles")
}

model UserRole {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  roleCode      String   @map("role_code")
  effectiveFrom DateTime @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  approvedBy    String?  @map("approved_by")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([userId, roleCode, effectiveFrom])
  @@index([userId, status])
  @@map("user_roles")
}

model UserResponsibility {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  responsibilityCode String   @map("responsibility_code")
  effectiveFrom      DateTime @default(now()) @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  approvedBy         String?  @map("approved_by")
  status             String   @default("active")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([userId, responsibilityCode, effectiveFrom])
  @@index([userId, status])
  @@map("user_responsibilities")
}

model UserAccessProfile {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  accessProfileCode String   @map("access_profile_code")
  effectiveFrom     DateTime @default(now()) @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  status            String   @default("active")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([userId, accessProfileCode, effectiveFrom])
  @@index([userId, status])
  @@map("user_access_profiles")
}

model AccessScope {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  scopeType   String   @map("scope_type")
  rules       Json
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("access_scopes")
}

model ClinicalScope {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  protocolSet Json?    @map("protocol_set")
  specialties Json?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("clinical_scopes")
}

model IntegrationScope {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  integrations Json
  allowedActions Json @map("allowed_actions")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("integration_scopes")
}

model UserQueueAssignment {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  queueCode     String   @map("queue_code")
  role          String
  effectiveFrom DateTime @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, queueCode, status])
  @@map("user_queue_assignments")
}

model AccessRequest {
  id             String   @id @default(cuid())
  requesterUserId String @map("requester_user_id")
  targetUserId   String  @map("target_user_id")
  requestedAccess Json   @map("requested_access")
  justification  String
  status         String  @default("pending")
  risk           String  @default("medium")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("access_requests")
}

model AccessApproval {
  id              String   @id @default(cuid())
  accessRequestId String   @map("access_request_id")
  approverUserId  String   @map("approver_user_id")
  decision        String
  comments        String?
  decidedAt       DateTime @default(now()) @map("decided_at")

  @@index([accessRequestId])
  @@map("access_approvals")
}

model SegregationOfDutyRule {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String
  conflictType  String   @map("conflict_type")
  leftScope     Json     @map("left_scope")
  rightScope    Json     @map("right_scope")
  severity      String   @default("high")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("segregation_of_duty_rules")
}

model AccessConflict {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  ruleCode    String   @map("rule_code")
  details     Json
  status      String   @default("open")
  detectedAt  DateTime @default(now()) @map("detected_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([userId, status])
  @@map("access_conflicts")
}

model TemporaryAccess {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  accessProfile  String   @map("access_profile")
  purpose        String
  effectiveFrom  DateTime @map("effective_from")
  effectiveTo    DateTime @map("effective_to")
  approvedBy     String?  @map("approved_by")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("temporary_access")
}

model BreakGlassAccess {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  encounterId    String?  @map("encounter_id")
  purpose        String
  justification  String
  expiresAt      DateTime @map("expires_at")
  reviewedBy     String?  @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, status])
  @@map("break_glass_access")
}

model AuthenticationProvider {
  id                  String   @id @default(cuid())
  providerKey         String   @unique @map("provider_key")
  name                String
  protocol            String
  enabled             Boolean  @default(false)
  tenantIdCiphertext  String?  @map("tenant_id_ciphertext")
  issuerUrl           String?  @map("issuer_url")
  authorizationEndpoint String? @map("authorization_endpoint")
  tokenEndpoint       String?  @map("token_endpoint")
  userInfoEndpoint    String?  @map("user_info_endpoint")
  clientIdCiphertext  String?  @map("client_id_ciphertext")
