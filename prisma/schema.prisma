  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("masking_policies")
}

model RevealPolicy {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  dataClassification    String   @map("data_classification")
  requiresMfa           Boolean  @default(true) @map("requires_mfa")
  requiresApproval      Boolean  @default(false) @map("requires_approval")
  allowedPurposes       Json     @map("allowed_purposes")
  revealDurationSeconds Int      @default(60) @map("reveal_duration_seconds")
  remaskOnBlur          Boolean  @default(true) @map("remask_on_blur")
  disableCopy           Boolean  @default(true) @map("disable_copy")
  status                String   @default("active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("reveal_policies")
}

model RevealRequest {
  id              String    @id @default(cuid())
  requesterUserId String    @map("requester_user_id")
  resourceType    String    @map("resource_type")
  resourceId      String    @map("resource_id")
  fieldName       String    @map("field_name")
  purpose         String
  status          String    @default("pending")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  expiresAt       DateTime? @map("expires_at")

  @@index([requesterUserId, status])
  @@map("reveal_requests")
}

model RevealApproval {
  id              String   @id @default(cuid())
  revealRequestId String   @map("reveal_request_id")
  approverUserId  String   @map("approver_user_id")
  decision        String
  comments        String?
  decidedAt       DateTime @default(now()) @map("decided_at")

  @@index([revealRequestId])
  @@map("reveal_approvals")
}

model RevealEvent {
  id              String   @id @default(cuid())
  revealRequestId String?  @map("reveal_request_id")
  userId          String   @map("user_id")
  resourceType    String   @map("resource_type")
  resourceId      String   @map("resource_id")
  fieldName       String   @map("field_name")
  purpose         String
  success         Boolean
  ipAddress       String?  @map("ip_address")
  device          String?
  occurredAt      DateTime @default(now()) @map("occurred_at")

  @@index([userId, occurredAt])
  @@map("reveal_events")
}

model CryptographicKeyReference {
  id             String    @id @default(cuid())
  keyAlias       String    @unique @map("key_alias")
  provider       String
  location       String
  keyClass       String    @map("key_class")
  currentVersion String    @map("current_version")
  status         String    @default("active")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("cryptographic_key_references")
}

model KeyRotationRecord {
  id          String    @id @default(cuid())
  keyAlias    String    @map("key_alias")
  fromVersion String    @map("from_version")
  toVersion   String    @map("to_version")
  status      String    @default("pending")
  approvedBy  String?   @map("approved_by")
  rotatedAt   DateTime? @map("rotated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([keyAlias, createdAt])
  @@map("key_rotation_records")
}

model PrivacyRequest {
  id           String    @id @default(cuid())
  requesterRef String    @map("requester_ref")
  requestType  String    @map("request_type")
  jurisdiction String
  status       String    @default("open")
  dueAt        DateTime? @map("due_at")
  assignedTo   String?   @map("assigned_to")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, dueAt])
  @@map("privacy_requests")
}

model RetentionPolicy {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  entityName      String   @map("entity_name")
  retentionPeriod Json     @map("retention_period")
  legalBasis      String?  @map("legal_basis")
  deletionMode    String   @map("deletion_mode")
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("retention_policies")
}

model LegalHold {
  id           String    @id @default(cuid())
  holdCode     String    @unique @map("hold_code")
  resourceType String    @map("resource_type")
  resourceId   String    @map("resource_id")
  reason       String
  status       String    @default("active")
  createdBy    String?   @map("created_by")
  releasedBy   String?   @map("released_by")
  releasedAt   DateTime? @map("released_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([resourceType, resourceId, status])
  @@map("legal_holds")
}

model SensitiveExportRequest {
  id                 String    @id @default(cuid())
  requesterUserId    String    @map("requester_user_id")
  exportType         String    @map("export_type")
  dataScope          Json      @map("data_scope")
  justification      String
  approvalStatus     String    @default("pending") @map("approval_status")
  encryptionRequired Boolean   @default(true) @map("encryption_required")
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([approvalStatus, createdAt])
  @@map("sensitive_export_requests")
}

model AuditEvent {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  userId            String?  @map("user_id")
  activeRole        String?  @map("active_role")
  organization      String?
  facility          String?
  department        String?
  action            String
  module            String
  resource          String?
  recordReference   String?  @map("record_reference")
  purpose           String?
  approvalReference String?  @map("approval_reference")
  ipAddress         String?  @map("ip_address")
  device            String?
  sessionHash       String?  @map("session_hash")
  success           Boolean
  riskLevel         String   @default("medium") @map("risk_level")
  metadata          Json?

  @@index([timestamp])
  @@index([userId, action])
  @@map("audit_events")
}
