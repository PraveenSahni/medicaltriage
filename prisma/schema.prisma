// =============================================================================
// STCC vendor-mirror layer - a faithful 1:1 copy of the real After-Hours
// Telehealth Triage Guidelines Access database schema, verified this session
// via ODBC + ADOX/COM against a real sample .mdb (Table/Column names, types,
// primary keys, and foreign-key cascade rules all confirmed directly against
// the vendor file, not approximated from documentation). Populated by
// scripts/extractStccMdb.ps1 + a loader that upserts this raw shape verbatim.
//
// This is intentionally separate from the app-facing Algorithm/TriageQuestion/
// CareAdvice models above: those use cuid() surrogate keys, bilingual fields,
// and app-specific concepts (provenance, demoEligible, DispositionCode enum)
// that have no equivalent in the vendor schema. This mirror exists so every
// annual STCC delivery can be diffed/re-synced mechanically against a stable,
// honestly-typed staging copy, then mapped into the app-facing models by
// src/data/stccLicensedContent - never read directly by application logic.
// =============================================================================

/// Mirrors AcuityRating (PK: AcuityRating_Numeric).
model MdbAcuityRating {
  acuityRatingNumeric           Int     @id @map("AcuityRating_Numeric")
  acuityRatingText              String? @map("AcuityRating_Text") @db.VarChar(50)
  acuityRatingColor             String? @map("AcuityRating_Color") @db.VarChar(50)
  acuityRatingColorAlternate    String? @map("AcuityRating_Color_Alternate") @db.VarChar(50)
  acuityRatingTitle             String? @map("AcuityRating_Title") @db.VarChar(50)
  /// Binary image columns exist in the real schema but are not imported by
  /// scripts/extractStccMdb.ps1 (no current UI consumes them) - always null.
  acuityRatingBullet            Bytes?  @map("AcuityRating_Bullet")
  acuityRatingColorAlternateImg Bytes?  @map("AcuityRating_Color_Alternate_Img")

  algorithms   MdbAlgorithm[]
  dispositions MdbDisposition[]

  @@map("Mdb_AcuityRating")
}

/// Mirrors System (PK: System). Real FK target of Algorithm.System.
model MdbSystem {
  system        String  @id @map("System") @db.VarChar(50)
  systemOrder   Int?    @map("System_Order")
  systemExample String? @map("System_Example") @db.VarChar(50)

  algorithms MdbAlgorithm[]

  @@map("Mdb_System")
}

/// Mirrors Type (PK: Type). Real FK target of Algorithm.Type.
model MdbType {
  type      String  @id @map("Type") @db.VarChar(50)
  typeTopic String? @map("Type_Topic") @db.VarChar(50)

  algorithms MdbAlgorithm[]

  @@map("Mdb_Type")
}

/// Mirrors Disposition (PK: LevelID). Real FK: AcuityRating -> AcuityRating.AcuityRating_Numeric
/// (UpdateRule=NONE, DeleteRule=NONE - restrict, matches the real .mdb).
model MdbDisposition {
  levelId                                       Int              @id @map("LevelID")
  createdDate                                   DateTime?        @map("CreatedDate")
  lastUpDate                                    DateTime?        @map("LastUpDate")
  dispositionHeading                            String?          @map("DispositionHeading") @db.VarChar(75)
  dispositionHeadingTelemedicine                String?          @map("DispositionHeading_Telemedicine") @db.VarChar(100)
  adultCareAdviceNumber                         Int?             @map("Adult_CareAdvice_Number")
  adultCareAdviceStatement                      String?          @map("Adult_CareAdvice_Statement") @db.Text
  adultCareAdviceStatementXhtml                 String?          @map("Adult_CareAdvice_Statement_XHTML") @db.Text
  adultCareAdviceStatementTelemedicine          String?          @map("Adult_CareAdvice_Statement_Telemedicine") @db.Text
  adultCareAdviceStatementXhtmlTelemedicine     String?          @map("Adult_CareAdvice_Statement_XHTML_Telemedicine") @db.Text
  pediatricCareAdviceNumber                     Int?             @map("Pediatric_CareAdvice_Number")
  pediatricCareAdviceStatement                  String?          @map("Pediatric_CareAdvice_Statement") @db.Text
  pediatricCareAdviceStatementXhtml             String?          @map("Pediatric_CareAdvice_Statement_XHTML") @db.Text
  pediatricCareAdviceStatementTelemedicine      String?          @map("Pediatric_CareAdvice_Statement_Telemedicine") @db.Text
  pediatricCareAdviceStatementXhtmlTelemedicine String?          @map("Pediatric_CareAdvice_Statement_XHTML_Telemedicine") @db.Text
  acuityRatingNumeric                           Int?             @map("AcuityRating")
  acuityRating                                  MdbAcuityRating? @relation(fields: [acuityRatingNumeric], references: [acuityRatingNumeric], onDelete: NoAction, onUpdate: NoAction)

  questions MdbQuestion[]

  @@map("Mdb_Disposition")
}

/// Mirrors Algorithm (PK: AlgorithmID). Real FKs: Acuity -> AcuityRating.AcuityRating_Numeric,
/// System -> System.System, Type -> Type.Type (all UpdateRule=CASCADE/NONE, DeleteRule=NONE
/// per the real .mdb - a lookup value can't be deleted while referenced, but renaming a
/// System/Type cascades).
model MdbAlgorithm {
  algorithmId                          Int       @id @map("AlgorithmID")
  author                               String?   @map("Author") @db.Text
  copyright                            String?   @map("Copyright") @db.Text
  createdDate                          DateTime? @map("CreatedDate")
  lastUpDate                           DateTime? @map("LastUpDate")
  lastReviewDate                       DateTime? @map("LastReviewDate")
  title                                String?   @map("Title") @db.VarChar(75)
  titleUpperCase                       String?   @map("Title_UpperCase") @db.VarChar(75)
  titleLastUpdate                      DateTime? @map("Title_LastUpdate")
  definition                           String?   @map("Definition") @db.Text
  definitionXhtml                      String?   @map("DefinitionXHTML") @db.Text
  definitionLastUpdate                 DateTime? @map("Definition_LastUpdate")
  initialAssessmentQuestions           String?   @map("InitialAssessmentQuestions") @db.Text
  initialAssessmentQuestionsLastUpdate DateTime? @map("InitalAssessmentQuestions_LastUpdate")
  background                           String?   @map("Background") @db.Text
  backgroundXhtml                      String?   @map("BackgroundXHTML") @db.Text
  backgroundLastUpdate                 DateTime? @map("BackGround_LastUpdate")
  firstAid                             String?   @map("FirstAid") @db.Text
  firstAidXhtml                        String?   @map("FirstAidXHTML") @db.Text
  firstAidLastUpdate                   DateTime? @map("FirstAid_LastUpdate")
  referenceLastUpdate                  DateTime? @map("Reference_LastUpdate")
  searchWordsLastUpdate                DateTime? @map("SearchWords_LastUpdate")
  questionsLastUpdate                  DateTime? @map("Questions_LastUpdate")
  caLastUpdate                         DateTime? @map("CA_LastUpdate")
  ahDescriptors                        Boolean?  @map("AH_DESCRIPTORS")
  category                             String?   @map("Category") @db.VarChar(20)
  group                                String?   @map("Group") @db.VarChar(30)
  typeName                             String?   @map("Type") @db.VarChar(50)
  systemName                           String?   @map("System") @db.VarChar(50)
  anatomy                              String?   @map("Anatomy") @db.VarChar(50)
  versionYear                          String?   @map("VersionYear") @db.VarChar(4)
  status                               String?   @map("Status") @db.VarChar(15)
  acuity                               Int?      @map("Acuity")
  gender                               String?   @map("Gender") @db.VarChar(1)
  ageGroup                             String?   @map("AgeGroup") @db.VarChar(10)
  minAgeYears                          Int?      @map("Min_Age_Years")
  maxAgeYears                          Int?      @map("Max_Age_Years")
  minAgeMonths                         Int?      @map("Min_Age_Months")
  maxAgeMonths                         Int?      @map("Max_Age_Months")
  wh                                   Boolean?  @map("WH")
  bh                                   Boolean?  @map("BH")
  oa                                   Boolean?  @map("OA")
  cd                                   Boolean?  @map("CD")
  hospice                              Boolean?  @map("Hospice")
  oncology                             Boolean?  @map("Oncology")
  prescriptionOption                   Boolean?  @map("Prescription_Option")
  cmsPrivate                           Boolean?  @map("CMS_PRIVATE")
  sampleGuidelines                     Boolean?  @map("SampleGuidelines")

  acuityRating MdbAcuityRating? @relation(fields: [acuity], references: [acuityRatingNumeric], onDelete: NoAction, onUpdate: NoAction)
  systemRef    MdbSystem?       @relation(fields: [systemName], references: [system], onDelete: NoAction, onUpdate: Cascade)
  typeRef      MdbType?         @relation(fields: [typeName], references: [type], onDelete: NoAction, onUpdate: Cascade)

  questions              MdbQuestion[]
  advice                 MdbAdvice[]
  algorithmReferences    MdbAlgorithmReference[]
  algorithmSearchWords   MdbAlgorithmSearchWord[]
  algorithmSupplementals MdbAlgorithmSupplemental[]

  // Operational app tables that reference this real vendor protocol id
  // directly (see resolveMdbAlgorithmId() in stccMdbMapper.ts).
  matchedByQueueItems TriageQueueItem[]
  usedInEncounters    AviationTriageEncounter[]
  voiceCallSessions   VoiceCallSession[]

  @@map("Mdb_Algorithm")
}

/// Mirrors Question (PK: QuestionID). Real FKs: AlgorithmID -> Algorithm.AlgorithmID
/// (CASCADE delete), DispositionLevel -> Disposition.LevelID (NONE - restrict).
model MdbQuestion {
  questionId           Int       @id @map("QuestionID")
  algorithmId          Int?      @map("AlgorithmID")
  questionOrder        Int?      @map("QuestionOrder")
  dateCreated          DateTime? @map("DateCreated")
  lastUpDate           DateTime? @map("LastUpDate")
  question             String?   @map("Question") @db.Text
  dispositionLevel     Int?      @map("DispositionLevel")
  information          String?   @map("Information") @db.Text
  smagLinkId           Int?      @map("SMAG_LINK_ID")
  cmsNew               Boolean?  @map("CMS_NEW")
  telemedicineEligible Boolean?  @map("TelemedicineEligible")

  algorithm      MdbAlgorithm?       @relation(fields: [algorithmId], references: [algorithmId], onDelete: Cascade, onUpdate: Cascade)
  disposition    MdbDisposition?     @relation(fields: [dispositionLevel], references: [levelId], onDelete: NoAction, onUpdate: NoAction)
  questionAdvice MdbQuestionAdvice[]

  @@map("Mdb_Question")
}

/// Mirrors Advice (PK: AdviceID). Real FK: AlgorithmID -> Algorithm.AlgorithmID (CASCADE).
model MdbAdvice {
  adviceId          Int       @id @map("AdviceID")
