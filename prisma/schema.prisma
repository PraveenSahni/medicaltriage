generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Clinical acuity floor returned by the deterministic triage engine.
enum TriageSeverity {
  EMERGENCY
  URGENT
  ROUTINE
  SELF_CARE
}

/// Localized disposition target used after the rules engine has set the safety floor.
enum AcuityDispositionCode {
  SIDRA_PEDIATRIC_ED
  HMC_EMERGENCY_DEPARTMENT
  HMC_URGENT_REVIEW
  IST_HIA_MIDFIELD_MEDICAL_CENTRE
  IST_OLD_AIRPORT_MEDICAL_COMMISSION
  PHCC_URGENT_CARE_OR_TELECONSULT
  OUTSTATION_TELECONSULT_ESCALATION
  SELF_CARE_WITH_CALLBACK_PRECAUTIONS
}

enum BiologicalSex {
  FEMALE
  MALE
  OTHER
  UNKNOWN
}

enum DutyStatus {
  ACTIVE
  ON_LEAVE
  REST_PERIOD
  SUSPENDED
  INACTIVE
}

enum DependentRelationship {
  SPOUSE
  SON
  DAUGHTER
  CHILD
  PARENT
  OTHER
}

enum InsuranceEligibilityStatus {
  ELIGIBLE
  SUSPENDED
  INELIGIBLE
  PENDING_VERIFICATION
  UNKNOWN
}

enum OverrideStatusFlag {
  AI_RECOMMENDATION_DIFFERED
  NURSE_OVERRIDE_UP
  NURSE_OVERRIDE_DOWN_BLOCKED
  RULES_ENGINE_FINAL
  REVIEW_REQUIRED
}

enum ProtocolMode {
  OFFICE_HOURS
  AFTER_HOURS
  BOTH
}

enum QueueStatus {
  INCOMING
  IN_PROCESS
  INFO_REQUIRED
  COMPLETED
}

enum QueueClinicalStage {
  INTAKE
  IDENTITY
  VITALS
  PROTOCOL
  DISPOSITION
  SBAR
}

enum DirectoryStatus {
  ACTIVE
  DISABLED
  ON_LEAVE
  REST_PERIOD
  INACTIVE
}

enum ClinicalContentSourceType {
  SYNTHETIC_SAMPLE
  LICENSED_STCC
  LOCAL_QATAR_OVERRIDE
}

enum ClinicalContentImportStatus {
  PENDING
  VALIDATED
  IMPORTED
  FAILED
}

enum RagShadowStatus {
  RECORDED
  BLOCKED
  REVIEWED
  PROMOTED_TO_RULE_REVIEW
}

enum ProtocolComparisonAgreement {
  FULL_MATCH
  PARTIAL_MATCH
  NO_MATCH
  NO_DETERMINISTIC_CANDIDATE
  NO_SHADOW_CANDIDATE
}

enum LearningFeedbackAction {
  NO_CHANGE
  ADD_SYNONYM
  ADJUST_KEYWORD_WEIGHT
  PROMPT_REVIEW
  CONTENT_REVIEW
  SAFETY_REVIEW
}

enum ModelEvaluationStatus {
  PLANNED
  RUNNING
  PASSED
  FAILED
  BLOCKED
}

enum SafetyBlockedOutputReason {
  UNSAFE_DOWNGRADE
  INVENTED_QUESTION
  INVENTED_CARE_ADVICE
  OUT_OF_BOUND_SOURCE
  PRIVACY_BOUNDARY
  OTHER
}

model ProtocolRelease {
  id                    String                     @id @default(cuid())
  name                  String
  version               String
  sourceType            ClinicalContentSourceType  @map("source_type")
  region                String                     @default("QA")
  mode                  ProtocolMode               @default(BOTH)
  active                Boolean                    @default(false)
  importedAt            DateTime?                  @map("imported_at")
  algorithms            Algorithm[]
  clinicalReferences    ClinicalReference[]
  clinicalSupplementals ClinicalSupplemental[]
  importJobs            ClinicalContentImportJob[]
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  @@unique([sourceType, version])
  @@index([region, active])
  @@map("protocol_releases")
}

model Algorithm {
  id                         String                    @id @default(cuid())
  releaseId                  String?                   @map("release_id")
  release                    ProtocolRelease?          @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  externalProtocolId         String?                   @unique @map("external_protocol_id")
  mode                       ProtocolMode              @default(BOTH)
  titleEn                    String                    @map("title_en")
  titleAr                    String?                   @map("title_ar")
  clinicalDefinitionEn       String?                   @map("clinical_definition_en")
  clinicalDefinitionAr       String?                   @map("clinical_definition_ar")
  backgroundInfoEn           String?                   @map("background_info_en")
  backgroundInfoAr           String?                   @map("background_info_ar")
  genderRestriction          BiologicalSex?            @map("gender_restriction")
  ageMin                     Int?                      @map("age_min")
  ageMax                     Int?                      @map("age_max")
  /// @deprecated Use ProtocolRelease.version through releaseId for canonical release lineage.
  stccVersion                String?                   @map("stcc_version")
  sourceRecordHash           String?                   @map("source_record_hash")
  sourceRecordChecksum       String?                   @map("source_record_checksum")
  sourceEffectiveFrom        DateTime?                 @map("source_effective_from")
  sourceEffectiveTo          DateTime?                 @map("source_effective_to")
  annualReconciliationStatus String?                   @map("annual_reconciliation_status")
  active                     Boolean                   @default(true)
  questions                  TriageQuestion[]
  careAdviceLinks            AlgorithmCareAdvice[]
  keywordIndexes             ProtocolKeywordIndex[]
  synonyms                   ProtocolSynonym[]
  dispositionMaps            ProtocolDispositionMap[]
  clinicalReferenceLinks     AlgorithmReference[]
  clinicalSupplementalLinks  AlgorithmSupplemental[]
  taxonomy                   ProtocolTaxonomy[]
  firstAidItems              ProtocolFirstAid[]
  encounters                 AviationTriageEncounter[]
  matchedQueueItems          TriageQueueItem[]
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")

  @@index([titleEn])
  @@index([releaseId, active])
  @@index([mode])
  @@map("algorithms")
}

model TriageQuestion {
  id                    String                 @id @default(cuid())
  algorithmId           String                 @map("algorithm_id")
  algorithm             Algorithm              @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  externalQuestionId    String?                @map("external_question_id")
  acuityOrder           Int                    @map("acuity_order")
  severityGrade         TriageSeverity         @map("severity_grade")
  questionTextEn        String                 @map("question_text_en")
  questionTextAr        String?                @map("question_text_ar")
  acuityDispositionCode AcuityDispositionCode  @map("acuity_disposition_code")
  rationaleEn           String?                @map("rationale_en")
  redFlag               Boolean                @default(false) @map("red_flag")
  branching             Json?                  @map("branching")
  telemedicineEligible  Boolean?               @map("telemedicine_eligible")
  telemedicineNotesEn   String?                @map("telemedicine_notes_en") @db.Text
  sourceRecordHash      String?                @map("source_record_hash")
  sourceRecordChecksum  String?                @map("source_record_checksum")
  careAdviceLinks       QuestionAdviceBridge[]
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([algorithmId, acuityOrder])
  @@index([externalQuestionId])
  @@map("triage_questions")
}

model CareAdvice {
  id                   String                 @id @default(cuid())
  externalCareAdviceId String?                @unique @map("external_care_advice_id")
  adviceTitleEn        String                 @map("advice_title_en")
  adviceTitleAr        String?                @map("advice_title_ar")
  instructionTextEn    String                 @map("instruction_text_en")
  instructionTextAr    String?                @map("instruction_text_ar")
  contentFormat        String                 @default("plain_text") @map("content_format")
  sanitizedHtmlEn      String?                @map("sanitized_html_en") @db.Text
  sanitizedHtmlAr      String?                @map("sanitized_html_ar") @db.Text
  sourceRecordHash     String?                @map("source_record_hash")
  sourceRecordChecksum String?                @map("source_record_checksum")
  dispositionCode      AcuityDispositionCode? @map("disposition_code")
  warningSigns         Json?                  @map("warning_signs")
  algorithmLinks       AlgorithmCareAdvice[]
  questionLinks        QuestionAdviceBridge[]
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@map("care_advice")
}

model AlgorithmCareAdvice {
  algorithmId  String     @map("algorithm_id")
  careAdviceId String     @map("care_advice_id")
  algorithm    Algorithm  @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  careAdvice   CareAdvice @relation(fields: [careAdviceId], references: [id], onDelete: Cascade)

  @@id([algorithmId, careAdviceId])
  @@map("algorithm_care_advice")
}

/// Bridge between a positive triage question and targeted care advice.
/// This is intentionally named close to the Phase I manual's
/// Question_Advice_Bridge contract so licensed STCC/Schmitt-Thompson imports can
/// map the same relationship without touching backend triage logic.
model QuestionAdviceBridge {
  questionId    String         @map("question_id")
  adviceId      String         @map("advice_id")
  triggerAnswer String         @default("YES") @map("trigger_answer")
  question      TriageQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  advice        CareAdvice     @relation(fields: [adviceId], references: [id], onDelete: Cascade)

  @@id([questionId, adviceId, triggerAnswer])
  @@map("question_advice_bridge")
}

model ProtocolKeywordIndex {
  id               String    @id @default(cuid())
  algorithmId      String    @map("algorithm_id")
  algorithm        Algorithm @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  phrase           String
  normalizedPhrase String    @map("normalized_phrase")
  language         String    @default("en")
  weight           Int       @default(50)
  source           String    @default("release")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([normalizedPhrase])
  @@index([algorithmId, weight])
  @@map("protocol_keyword_indexes")
}

model ProtocolSynonym {
  id            String     @id @default(cuid())
  algorithmId   String?    @map("algorithm_id")
  algorithm     Algorithm? @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  canonicalTerm String     @map("canonical_term")
  synonym       String
  language      String     @default("en")
  region        String     @default("QA")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([canonicalTerm, synonym])
  @@map("protocol_synonyms")
}

model ProtocolDispositionMap {
  id                    String                @id @default(cuid())
  algorithmId           String?               @map("algorithm_id")
  algorithm             Algorithm?            @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  severity              TriageSeverity
  dispositionCode       AcuityDispositionCode @map("disposition_code")
  ageMin                Int?                  @map("age_min")
  ageMax                Int?                  @map("age_max")
  aviationContext       Json?                 @map("aviation_context")
  routeLabelEn          String                @map("route_label_en")
  routeLabelAr          String?               @map("route_label_ar")
  routeRationaleEn      String                @map("route_rationale_en")
  routeRationaleAr      String?               @map("route_rationale_ar")
  telemedicineHeadingEn String?               @map("telemedicine_heading_en")
  telemedicineHeadingAr String?               @map("telemedicine_heading_ar")
  sourceOfCareEn        String?               @map("source_of_care_en")
  sourceOfCareAr        String?               @map("source_of_care_ar")
  active                Boolean               @default(true)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@index([severity, dispositionCode])
  @@index([algorithmId, active])
  @@map("protocol_disposition_maps")
}

model LocalizedDisposition {
  id                String                @id @default(cuid())
  code              AcuityDispositionCode @unique
  destinationNameEn String                @map("destination_name_en")
  destinationNameAr String?               @map("destination_name_ar")
  routingNotesEn    String                @map("routing_notes_en")
  routingNotesAr    String?               @map("routing_notes_ar")
  region            String                @default("QA")
  active            Boolean               @default(true)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([region, active])
  @@map("localized_dispositions")
}

model ClinicalContentImportJob {
  id              String                       @id @default(cuid())
  releaseId       String?                      @map("release_id")
  release         ProtocolRelease?             @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  sourceUri       String                       @map("source_uri")
  sourceChecksum  String?                      @map("source_checksum")
  status          ClinicalContentImportStatus  @default(PENDING)
  importerVersion String                       @default("phase1-importer") @map("importer_version")
  rowsRead        Int                          @default(0) @map("rows_read")
  rowsInserted    Int                          @default(0) @map("rows_inserted")
  rowsSkipped     Int                          @default(0) @map("rows_skipped")
  errorCount      Int                          @default(0) @map("error_count")
  startedAt       DateTime                     @default(now()) @map("started_at")
  finishedAt      DateTime?                    @map("finished_at")
  errors          ClinicalContentImportError[]

  @@index([status, startedAt])
  @@map("clinical_content_import_jobs")
}

model ClinicalContentImportError {
  id             String                   @id @default(cuid())
  importJobId    String                   @map("import_job_id")
  importJob      ClinicalContentImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  sourceRecordId String?                  @map("source_record_id")
  tableName      String?                  @map("table_name")
  message        String
  severity       String                   @default("error")
  createdAt      DateTime                 @default(now()) @map("created_at")

  @@index([importJobId])
  @@map("clinical_content_import_errors")
}

model ClinicalReference {
  id                  String               @id @default(cuid())
  releaseId           String?              @map("release_id")
  release             ProtocolRelease?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  externalReferenceId String?              @map("external_reference_id")
  title               String
  sourceName          String?              @map("source_name")
  citationText        String?              @map("citation_text") @db.Text
  url                 String?
  referenceType       String?              @map("reference_type")
  sourceRecordHash    String?              @map("source_record_hash")
  algorithmLinks      AlgorithmReference[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([releaseId, externalReferenceId])
  @@index([releaseId])
  @@map("clinical_references")
}

model AlgorithmReference {
  algorithmId  String            @map("algorithm_id")
  referenceId  String            @map("reference_id")
  algorithm    Algorithm         @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  reference    ClinicalReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  displayOrder Int               @default(0) @map("display_order")
  sectionLabel String?           @map("section_label")

  @@id([algorithmId, referenceId])
  @@map("algorithm_references")
}

model ClinicalSupplemental {
  id                     String                  @id @default(cuid())
  releaseId              String?                 @map("release_id")
  release                ProtocolRelease?        @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  externalSupplementalId String?                 @map("external_supplemental_id")
  titleEn                String                  @map("title_en")
  titleAr                String?                 @map("title_ar")
  supplementalType       String                  @map("supplemental_type")
  plainTextEn            String?                 @map("plain_text_en") @db.Text
  plainTextAr            String?                 @map("plain_text_ar") @db.Text
  sanitizedHtmlEn        String?                 @map("sanitized_html_en") @db.Text
  sanitizedHtmlAr        String?                 @map("sanitized_html_ar") @db.Text
  sourceRecordHash       String?                 @map("source_record_hash")
  algorithmLinks         AlgorithmSupplemental[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@unique([releaseId, externalSupplementalId])
  @@index([releaseId, supplementalType])
  @@map("clinical_supplementals")
}

model AlgorithmSupplemental {
  algorithmId    String               @map("algorithm_id")
  supplementalId String               @map("supplemental_id")
  algorithm      Algorithm            @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  supplemental   ClinicalSupplemental @relation(fields: [supplementalId], references: [id], onDelete: Cascade)
  displayOrder   Int                  @default(0) @map("display_order")
  sectionLabel   String?              @map("section_label")

  @@id([algorithmId, supplementalId])
  @@map("algorithm_supplementals")
}

model ProtocolTaxonomy {
  id           String    @id @default(cuid())
  algorithmId  String    @map("algorithm_id")
  algorithm    Algorithm @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  category     String
  value        String
  source       String    @default("STCC")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([algorithmId, category, value])
  @@index([category, value])
  @@map("protocol_taxonomy")
}

model ProtocolFirstAid {
  id                String    @id @default(cuid())
  algorithmId       String    @map("algorithm_id")
  algorithm         Algorithm @relation(fields: [algorithmId], references: [id], onDelete: Cascade)
  titleEn           String?   @map("title_en")
  titleAr           String?   @map("title_ar")
  instructionTextEn String    @map("instruction_text_en") @db.Text
  instructionTextAr String?   @map("instruction_text_ar") @db.Text
  sanitizedHtmlEn   String?   @map("sanitized_html_en") @db.Text
  sanitizedHtmlAr   String?   @map("sanitized_html_ar") @db.Text
  displayOrder      Int       @default(0) @map("display_order")
  sourceRecordHash  String?   @map("source_record_hash")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([algorithmId])
  @@map("protocol_first_aid")
}

model StaffMember {
  id                         String                     @id @default(cuid())
  istStaffId                 String                     @unique @map("ist_staff_id")
  department                 String
  jobTitle                   String                     @map("job_title")
  dutyStatus                 DutyStatus                 @default(ACTIVE) @map("duty_status")
  insuranceProvider          String?                    @map("insurance_provider")
  insuranceEligibilityStatus InsuranceEligibilityStatus @default(UNKNOWN) @map("insurance_eligibility_status")
  insuranceLastChecked       DateTime?                  @map("insurance_last_checked")
  dateOfBirth                DateTime?                  @map("date_of_birth")
  dependents                 Dependent[]
  encounters                 AviationTriageEncounter[]
  queueItems                 TriageQueueItem[]
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")

  @@index([department])
  @@map("staff_members")
}

model Dependent {
  id               String                    @id @default(cuid())
  staffMemberId    String                    @map("staff_member_id")
  staffMember      StaffMember               @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  fullName         String                    @map("full_name")
  relationshipType DependentRelationship     @map("relationship")
  /// @deprecated Age must be calculated from HRMS dateOfBirth at runtime; retained for legacy imports and old FHIR fallback.
  age              Int
  dateOfBirth      DateTime?                 @map("date_of_birth")
  biologicalSex    BiologicalSex             @map("biological_sex")
  encounters       AviationTriageEncounter[]
  queueItems       TriageQueueItem[]
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@index([staffMemberId])
  @@map("dependents")
}

model AviationTriageEncounter {
  id                   String                   @id @default(cuid())
  staffMemberId        String                   @map("staff_member_id")
  staffMember          StaffMember              @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  dependentId          String?                  @map("dependent_id")
  dependent            Dependent?               @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  protocolUsedId       String?                  @map("protocol_used_id")
  protocolUsed         Algorithm?               @relation(fields: [protocolUsedId], references: [id], onDelete: SetNull)
  /// @deprecated Use finalDispositionCode plus safetyLog.explainabilityTrace for deterministic acuity lineage.
  initialAcuityScore   Int                      @map("initial_acuity_score")
  finalDispositionCode AcuityDispositionCode    @map("final_disposition_code")
  audioRecordingUrl    String?                  @map("audio_recording_url")
  transcriptText       String?                  @map("transcript_text")
  transcriptLanguage   String?                  @map("transcript_language")
  customAviationTags   Json?                    @map("custom_aviation_tags")
  clipboardPayload     Json?                    @map("clipboard_payload")
  nurseId              String                   @map("nurse_id")
  completedAt          DateTime?                @map("completed_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  safetyLog            SafetyAuditDeviationLog?

  @@index([staffMemberId, createdAt])
  @@index([finalDispositionCode])
  @@map("aviation_triage_encounters")
}

model SafetyAuditDeviationLog {
  id                       String                  @id @default(cuid())
  encounterId              String                  @unique @map("encounter_id")
  encounter                AviationTriageEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  originalAiRecommendation String                  @map("original_ai_recommendation")
  nurseOverrideRationale   String?                 @map("nurse_override_rationale")
  rulesEngineSeverity      TriageSeverity          @map("rules_engine_severity")
  overrideStatusFlag       OverrideStatusFlag      @map("override_status_flag")
  isCriticalFloorBreach    Boolean                 @default(false) @map("is_critical_floor_breach")
  explainabilityTrace      Json                    @map("explainability_trace")
  createdAt                DateTime                @default(now()) @map("created_at")

  @@index([overrideStatusFlag, createdAt])
  @@index([isCriticalFloorBreach, createdAt])
  @@map("safety_audit_deviation_logs")
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  code                String               @unique
  mophLicenseNumber   String?              @map("moph_license_number")
  country             String               @default("QA")
  dataResidencyRegion String               @default("gcp-me-central1") @map("data_residency_region")
  users               ApplicationUser[]
  sourceQueueItems    TriageQueueItem[]    @relation("QueueSourceOrganization")
  targetQueueItems    TriageQueueItem[]    @relation("QueueTargetOrganization")
  actorTransitions    QueueTransitionLog[] @relation("QueueTransitionActorOrganization")
  targetTransitions   QueueTransitionLog[] @relation("QueueTransitionTargetOrganization")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("organizations")
}

model TriageQueueItem {
  id                       String                    @id @default(cuid())
  istStaffId               String                    @map("ist_staff_id")
  staffMemberId            String?                   @map("staff_member_id")
  staffMember              StaffMember?              @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  dependentId              String?                   @map("dependent_id")
  dependent                Dependent?                @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  organizationId           String?                   @map("organization_id")
  organization             Organization?             @relation("QueueSourceOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  targetOrganizationId     String?                   @map("target_organization_id")
  targetOrganization       Organization?             @relation("QueueTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: SetNull)
  status                   QueueStatus               @default(INCOMING)
  currentStage             QueueClinicalStage        @default(INTAKE) @map("current_stage")
  priorityScore            Int                       @default(0) @map("priority_score")
  patientType              String                    @default("Staff") @map("patient_type")
  channel                  String                    @default("Phone")
  stationCode              String?                   @map("station_code")
  outstationCode           String?                   @map("outstation_code")
  department               String?
  jobTitle                 String?                   @map("job_title")
  summary                  String?                   @db.Text
  vitals                   Json?
  matchedProtocolId        String?                   @map("matched_protocol_id")
  matchedProtocol          Algorithm?                @relation(fields: [matchedProtocolId], references: [id], onDelete: SetNull)
  calculatedSeverity       TriageSeverity?           @map("calculated_severity")
  dispositionCode          AcuityDispositionCode?    @map("disposition_code")
  destinationName          String?                   @map("destination_name")
  identityValidated        Boolean                   @default(false) @map("identity_validated")
  safetyFloorActive        Boolean                   @default(false) @map("safety_floor_active")
  clinicalApproval         Json?                     @map("clinical_approval")
  sbarCopied               Boolean                   @default(false) @map("sbar_copied")
  assignedNurseId          String?                   @map("assigned_nurse_id")
  claimedAt                DateTime?                 @map("claimed_at")
  slaDeadline              DateTime                  @map("sla_deadline")
  lockedBy                 String?                   @map("locked_by")
  lockExpiresAt            DateTime?                 @map("lock_expires_at")
  customAviationTags       Json?                     @map("custom_aviation_tags")
  queuePayload             Json?                     @map("queue_payload")
  transitionLogs           QueueTransitionLog[]
  ragRetrievalEvents       RagRetrievalEvent[]
  llmShadowSuggestions     LlmShadowSuggestion[]
  nurseSelectionEvents     NurseSelectionEvent[]
  protocolComparisonEvents ProtocolComparisonEvent[]
  safetyBlockedOutputs     SafetyBlockedOutput[]
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  @@index([status, currentStage])
  @@index([priorityScore, slaDeadline])
  @@index([assignedNurseId, status])
  @@index([lockedBy, lockExpiresAt])
  @@index([organizationId, status])
  @@index([targetOrganizationId, status])
