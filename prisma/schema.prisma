// Persistent grant/revoke overrides layered on top of the hardcoded role
// baseline in src/services/securityAdmin.ts - closes NFR-030/031/032
// ("Administrators add/remove access to screens/data/API endpoints for
// roles"), which previously required a source change + redeploy. The
// baseline itself stays source-controlled/reviewable; this table only
// records explicit deltas from it.
model RolePermission {
  id             String    @id @default(cuid())
  roleCode       String    @map("role_code")
  permissionCode String    @map("permission_code")
  action         String // "GRANT" | "REVOKE"
  effectiveFrom  DateTime  @default(now()) @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  grantedBy      String    @map("granted_by")
  reason         String
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([roleCode, status])
  @@map("role_permissions")
}

// Closes NFR-119 - a real, QR-facing capability to configure security
// anomaly-detection thresholds (auth-failure/reveal-anomaly counts) at
// runtime, without redeploying. Terraform-managed Cloud Monitoring alert
// policies (terraform/alerting.tf) stay engineer-owned IaC - this is a
// separate, application-level threshold layer the app's own anomaly
// detection (securityAdmin.ts) reads from, mirroring RolePermission's
// override-on-top-of-a-default pattern above.
model SecurityThresholdOverride {
  key       String   @id
  value     Int
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("security_threshold_overrides")
}

