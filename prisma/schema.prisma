generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Clinical acuity floor returned by the deterministic triage engine.
enum TriageSeverity {
  EMERGENCY
  URGENT
  ROUTINE
  SELF_CARE
}

/// Localized disposition target used after the rules engine has set the safety floor.
enum AcuityDispositionCode {
  SIDRA_PEDIATRIC_ED
  HMC_EMERGENCY_DEPARTMENT
  HMC_URGENT_REVIEW
  IST_HIA_MIDFIELD_MEDICAL_CENTRE
  IST_OLD_AIRPORT_MEDICAL_COMMISSION
  PHCC_URGENT_CARE_OR_TELECONSULT
  OUTSTATION_TELECONSULT_ESCALATION
  SELF_CARE_WITH_CALLBACK_PRECAUTIONS
}

enum BiologicalSex {
  FEMALE
  MALE
  OTHER
  UNKNOWN
}

/// Adult/pediatric partitioning. STCC ships separate adult and pediatric
/// databases; this app uses one normalized store with this discriminator.
enum PatientGroup {
  ADULT
  PEDIATRIC
  MIXED
  UNKNOWN
}

/// Approximates STCC's four Care Advice audience/type categories
/// (Disposition / Note-to-Triager / General / Call-Back-If).
enum CareAdviceCategory {
  DISPOSITION
  NOTE_TO_TRIAGER
  GENERAL
  CALL_BACK_IF
}

enum DutyStatus {
  ACTIVE
  ON_LEAVE
  REST_PERIOD
  SUSPENDED
  INACTIVE
}

enum DependentRelationship {
  SPOUSE
  SON
  DAUGHTER
  CHILD
  PARENT
  OTHER
}

enum InsuranceEligibilityStatus {
  ELIGIBLE
  SUSPENDED
  INELIGIBLE
  PENDING_VERIFICATION
  UNKNOWN
}

enum OverrideStatusFlag {
  AI_RECOMMENDATION_DIFFERED
  NURSE_OVERRIDE_UP
  NURSE_OVERRIDE_DOWN_BLOCKED
  RULES_ENGINE_FINAL
  REVIEW_REQUIRED
}

enum ProtocolMode {
  OFFICE_HOURS
  AFTER_HOURS
  BOTH
}

enum QueueStatus {
  INCOMING
  IN_PROCESS
  INFO_REQUIRED
  COMPLETED
}

enum QueueClinicalStage {
  INTAKE
  IDENTITY
  VITALS
  PROTOCOL
  DISPOSITION
  SBAR
}

enum DirectoryStatus {
  ACTIVE
  DISABLED
  ON_LEAVE
  REST_PERIOD
  INACTIVE
}

enum ClinicalContentSourceType {
  SYNTHETIC_SAMPLE
  LICENSED_STCC
  LOCAL_QATAR_OVERRIDE
}

enum ClinicalContentImportStatus {
  PENDING
  VALIDATED
  IMPORTED
  FAILED
}

enum RagShadowStatus {
  RECORDED
  BLOCKED
  REVIEWED
  PROMOTED_TO_RULE_REVIEW
}

enum ProtocolComparisonAgreement {
  FULL_MATCH
  PARTIAL_MATCH
  NO_MATCH
  NO_DETERMINISTIC_CANDIDATE
  NO_SHADOW_CANDIDATE
}

enum LearningFeedbackAction {
  NO_CHANGE
  ADD_SYNONYM
  ADJUST_KEYWORD_WEIGHT
  PROMPT_REVIEW
  CONTENT_REVIEW
  SAFETY_REVIEW
}

enum ModelEvaluationStatus {
  PLANNED
  RUNNING
  PASSED
  FAILED
  BLOCKED
}

enum SafetyBlockedOutputReason {
  UNSAFE_DOWNGRADE
  INVENTED_QUESTION
  INVENTED_CARE_ADVICE
  OUT_OF_BOUND_SOURCE
  PRIVACY_BOUNDARY
  OTHER
}

enum InitialAssessmentResponseType {
  OPEN_TEXT
  YES_NO
  LOCATION
  DURATION
  PAIN_SCALE
  TEMPERATURE
}

enum VoiceSessionStatus {
  CREATED
  ACTIVE
  AWAITING_NURSE_VALIDATION
  NURSE_TAKEOVER
  COMPLETED
  CANCELLED
}

enum VoiceTurnStatus {
  READY
  NEEDS_CLARIFICATION
  AWAITING_NURSE_VALIDATION
  VALIDATED
  REJECTED
}

enum VoiceAnswerClassification {
  YES
  NO
  OPEN_TEXT
  UNCERTAIN
  INTERRUPTED
  EMERGENCY_SIGNAL
}

enum VoiceValidationStatus {
  PENDING
  VALIDATED
  CORRECTED
  REJECTED
}

enum ClinicalAudioAssetStatus {
  DRAFT
  APPROVED
  RETIRED
}

// =============================================================================
// The old app-facing STCC clinical-content domain (ProtocolRelease, Algorithm,
// InitialAssessmentQuestion, ClinicalAudioAsset, TriageQuestion, CareAdvice,
// AlgorithmCareAdvice, QuestionAdviceBridge, ProtocolKeywordIndex,
// ProtocolSynonym, ProtocolDispositionMap, LocalizedDisposition, Disposition,
// AcuityRating, StccSystem, StccType, ClinicalContentImportJob/Error,
// ClinicalReference, AlgorithmReference, ClinicalSupplemental,
// AlgorithmSupplemental, ProtocolTaxonomy, ProtocolFirstAid - ~28 models) has
// been removed entirely. Real STCC content is now read exclusively from the
// Mdb* vendor-mirror tables further down this file via
// src/services/stccMdbMapper.ts; the operational FKs that used to anchor into
// Algorithm/InitialAssessmentQuestion (TriageQueueItem.matchedProtocolId,
// AviationTriageEncounter.protocolUsedId, VoiceCallSession.protocolId) now
// point directly at MdbAlgorithm.algorithmId instead.
// =============================================================================

model StaffMember {
  id                         String                     @id @default(cuid())
  istStaffId                 String                     @unique @map("ist_staff_id")
  // Multi-tenant scoping. Nullable so pre-existing rows stay valid; every new
  // row is expected to set it. Dependents inherit tenancy via staffMember.
  organizationId             String?                    @map("organization_id")
  department                 String
  jobTitle                   String                     @map("job_title")
  dutyStatus                 DutyStatus                 @default(ACTIVE) @map("duty_status")
  insuranceProvider          String?                    @map("insurance_provider")
  insuranceEligibilityStatus InsuranceEligibilityStatus @default(UNKNOWN) @map("insurance_eligibility_status")
  insuranceLastChecked       DateTime?                  @map("insurance_last_checked")
  dateOfBirth                DateTime?                  @map("date_of_birth")
  dependents                 Dependent[]
  encounters                 AviationTriageEncounter[]
  queueItems                 TriageQueueItem[]
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")

  @@index([department])
  @@index([organizationId])
  @@map("staff_members")
}

model Dependent {
  id               String                    @id @default(cuid())
  staffMemberId    String                    @map("staff_member_id")
  staffMember      StaffMember               @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  fullName         String                    @map("full_name")
  relationshipType DependentRelationship     @map("relationship")
  /// @deprecated Age must be calculated from HRMS dateOfBirth at runtime; retained for legacy imports and old FHIR fallback.
  age              Int
  dateOfBirth      DateTime?                 @map("date_of_birth")
  biologicalSex    BiologicalSex             @map("biological_sex")
  encounters       AviationTriageEncounter[]
  queueItems       TriageQueueItem[]
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@index([staffMemberId])
  @@map("dependents")
}

model AviationTriageEncounter {
  id                   String                   @id @default(cuid())
  // Multi-tenant scoping (SOC 2 review finding: this table previously had no
  // org column at all, so approval queue / safety dashboard / EMR writeback
  // were cross-tenant). Nullable so pre-existing rows stay valid; every new
  // encounter is expected to set it. SafetyAuditDeviationLog inherits tenancy
  // via this parent.
  organizationId       String?                  @map("organization_id")
  staffMemberId        String                   @map("staff_member_id")
  staffMember          StaffMember              @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  dependentId          String?                  @map("dependent_id")
  dependent            Dependent?               @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  protocolUsedId       Int?                     @map("protocol_used_id")
  protocolUsed         MdbAlgorithm?            @relation(fields: [protocolUsedId], references: [algorithmId], onDelete: SetNull)
  /// @deprecated Use finalDispositionCode plus safetyLog.explainabilityTrace for deterministic acuity lineage.
  initialAcuityScore   Int                      @map("initial_acuity_score")
  finalDispositionCode AcuityDispositionCode    @map("final_disposition_code")
  audioRecordingUrl    String?                  @map("audio_recording_url")
  transcriptText       String?                  @map("transcript_text")
  transcriptLanguage   String?                  @map("transcript_language")
  customAviationTags   Json?                    @map("custom_aviation_tags")
  clipboardPayload     Json?                    @map("clipboard_payload")
  nurseId              String                   @map("nurse_id")
  completedAt          DateTime?                @map("completed_at")
  // Idempotency key for /triage/complete - the queue item being completed
  // (a queue item can only ever be completed once). Nullable/unique rather
  // than required so existing rows created before this column existed remain
  // valid; every new completion going forward is expected to set it.
  sourceQueueItemId    String?                  @unique @map("source_queue_item_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  safetyLog            SafetyAuditDeviationLog?

  @@index([staffMemberId, createdAt])
  @@index([finalDispositionCode])
  @@index([organizationId, createdAt])
  @@map("aviation_triage_encounters")
}

model SafetyAuditDeviationLog {
  id                       String                  @id @default(cuid())
  encounterId              String                  @unique @map("encounter_id")
  encounter                AviationTriageEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  originalAiRecommendation String                  @map("original_ai_recommendation")
  nurseOverrideRationale   String?                 @map("nurse_override_rationale")
  rulesEngineSeverity      TriageSeverity          @map("rules_engine_severity")
  overrideStatusFlag       OverrideStatusFlag      @map("override_status_flag")
  isCriticalFloorBreach    Boolean                 @default(false) @map("is_critical_floor_breach")
  explainabilityTrace      Json                    @map("explainability_trace")
  createdAt                DateTime                @default(now()) @map("created_at")

  @@index([overrideStatusFlag, createdAt])
  @@index([isCriticalFloorBreach, createdAt])
  @@map("safety_audit_deviation_logs")
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  code                String               @unique
  mophLicenseNumber   String?              @map("moph_license_number")
  country             String               @default("QA")
  dataResidencyRegion String               @default("gcp-me-central1") @map("data_residency_region")
  users               ApplicationUser[]
  sourceQueueItems    TriageQueueItem[]    @relation("QueueSourceOrganization")
  targetQueueItems    TriageQueueItem[]    @relation("QueueTargetOrganization")
  actorTransitions    QueueTransitionLog[] @relation("QueueTransitionActorOrganization")
  targetTransitions   QueueTransitionLog[] @relation("QueueTransitionTargetOrganization")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("organizations")
}

model TriageQueueItem {
  id                       String                    @id @default(cuid())
  istStaffId               String                    @map("ist_staff_id")
  staffMemberId            String?                   @map("staff_member_id")
  staffMember              StaffMember?              @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  dependentId              String?                   @map("dependent_id")
  dependent                Dependent?                @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  organizationId           String?                   @map("organization_id")
  organization             Organization?             @relation("QueueSourceOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  targetOrganizationId     String?                   @map("target_organization_id")
  targetOrganization       Organization?             @relation("QueueTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: SetNull)
  status                   QueueStatus               @default(INCOMING)
  currentStage             QueueClinicalStage        @default(INTAKE) @map("current_stage")
  priorityScore            Int                       @default(0) @map("priority_score")
  patientType              String                    @default("Staff") @map("patient_type")
  channel                  String                    @default("Phone")
  stationCode              String?                   @map("station_code")
  outstationCode           String?                   @map("outstation_code")
  department               String?
  jobTitle                 String?                   @map("job_title")
  summary                  String?                   @db.Text
  vitals                   Json?
  matchedProtocolId        Int?                      @map("matched_protocol_id")
  matchedProtocol          MdbAlgorithm?             @relation(fields: [matchedProtocolId], references: [algorithmId], onDelete: SetNull)
  calculatedSeverity       TriageSeverity?           @map("calculated_severity")
  dispositionCode          AcuityDispositionCode?    @map("disposition_code")
  destinationName          String?                   @map("destination_name")
  identityValidated        Boolean                   @default(false) @map("identity_validated")
  safetyFloorActive        Boolean                   @default(false) @map("safety_floor_active")
  clinicalApproval         Json?                     @map("clinical_approval")
  sbarCopied               Boolean                   @default(false) @map("sbar_copied")
  assignedNurseId          String?                   @map("assigned_nurse_id")
  claimedAt                DateTime?                 @map("claimed_at")
  slaDeadline              DateTime                  @map("sla_deadline")
  lockedBy                 String?                   @map("locked_by")
  lockExpiresAt            DateTime?                 @map("lock_expires_at")
  customAviationTags       Json?                     @map("custom_aviation_tags")
  queuePayload             Json?                     @map("queue_payload")
  transitionLogs           QueueTransitionLog[]
  callCenterSessions       CallCenterSession[]
  ragRetrievalEvents       RagRetrievalEvent[]
  llmShadowSuggestions     LlmShadowSuggestion[]
  nurseSelectionEvents     NurseSelectionEvent[]
  protocolComparisonEvents ProtocolComparisonEvent[]
  safetyBlockedOutputs     SafetyBlockedOutput[]
  voiceSessions            VoiceCallSession[]
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  // Closes NFR-011 (audit lifecycle retention) - deleteQueueItem() now soft-
  // deletes (sets these two fields) instead of removing the row, so the
  // record a queue-item AuditEvent describes still exists to be traced back
  // to, throughout its entire lifecycle including after "deletion".
  deletedAt                DateTime?                 @map("deleted_at")
  deletedBy                String?                   @map("deleted_by")

  @@index([status, currentStage])
  @@index([priorityScore, slaDeadline])
  @@index([assignedNurseId, status])
  @@index([lockedBy, lockExpiresAt])
  @@index([organizationId, status])
  @@index([targetOrganizationId, status])
  @@index([istStaffId, createdAt])
  @@index([deletedAt])
  @@map("triage_queue_items")
}

model QueueTransitionLog {
  id                   String             @id @default(cuid())
  queueItemId          String             @map("queue_item_id")
  queueItem            TriageQueueItem    @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  actorId              String             @map("actor_id")
  actorOrganizationId  String?            @map("actor_organization_id")
  actorOrganization    Organization?      @relation("QueueTransitionActorOrganization", fields: [actorOrganizationId], references: [id], onDelete: SetNull)
  actorRole            String             @map("actor_role")
  targetOrganizationId String?            @map("target_organization_id")
  targetOrganization   Organization?      @relation("QueueTransitionTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: SetNull)
  eventType            String             @default("QUEUE_TRANSITION") @map("event_type")
  fromStatus           QueueStatus        @map("from_status")
  toStatus             QueueStatus        @map("to_status")
  fromStage            QueueClinicalStage @map("from_stage")
  toStage              QueueClinicalStage @map("to_stage")
  reason               String?            @db.Text
  auditSignature       String             @map("audit_signature")
  tracePayload         Json               @map("trace_payload")
  timestamp            DateTime           @default(now())

  @@index([queueItemId, timestamp])
  @@index([actorId, timestamp])
  @@index([actorOrganizationId, timestamp])
  @@map("queue_transition_logs")
}

model CallCenterSession {
  id                         String             @id
  queueItemId                String?            @map("queue_item_id")
  queueItem                  TriageQueueItem?   @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  // Multi-tenant scoping - nullable, expected to be set on every new row.
  organizationId             String?            @map("organization_id")
  provider                   String
  externalCallId             String             @map("external_call_id")
  direction                  String
  channel                    String
  status                     String
  aniMasked                  String?            @map("ani_masked")
  aniHash                    String?            @map("ani_hash")
  dnis                       String?
  language                   String             @default("en")
  queueName                  String?            @map("queue_name")
  agentId                    String?            @map("agent_id")
  recordingGovernance        Json?              @map("recording_governance")
  requiresIdentityResolution Boolean            @default(false) @map("requires_identity_resolution")
  startedAt                  DateTime?          @map("started_at")
  connectedAt                DateTime?          @map("connected_at")
  endedAt                    DateTime?          @map("ended_at")
  events                     CallCenterEvent[]
  voiceSessions              VoiceCallSession[]
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")

  @@unique([provider, externalCallId])
  @@index([queueItemId, status])
  @@index([agentId, status])
  @@index([organizationId])
  @@map("call_center_sessions")
}

model VoiceCallSession {
  id                           String                @id @default(cuid())
  // Multi-tenant scoping - nullable, expected to be set on every new row.
  organizationId               String?               @map("organization_id")
  callCenterSessionId          String?               @map("call_center_session_id")
  callCenterSession            CallCenterSession?    @relation(fields: [callCenterSessionId], references: [id], onDelete: SetNull)
  queueItemId                  String?               @map("queue_item_id")
  queueItem                    TriageQueueItem?      @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  protocolId                   Int                   @map("protocol_id")
  protocol                     MdbAlgorithm          @relation(fields: [protocolId], references: [algorithmId], onDelete: Restrict)
  releaseVersion               String                @map("release_version")
  language                     String                @default("en")
  status                       VoiceSessionStatus    @default(CREATED)
  // No real per-row IAQ table exists in the vendor schema (InitialAssessmentQuestions
  // is one free-text blob per Algorithm, verified via ODBC) - this stays a plain,
  // non-relational id (the same synthetic "{protocolId}-iaq-{n}" ids
  // stccMdbMapper.ts already generates) rather than a fabricated FK.
  currentQuestionId            String?               @map("current_question_id")
  clarificationAttempts        Int                   @default(0) @map("clarification_attempts")
  maxClarificationAttempts     Int                   @default(1) @map("max_clarification_attempts")
  createdByUserId              String                @map("created_by_user_id")
  recordingNoticePlayed        Boolean               @default(false) @map("recording_notice_played")
  recordingAuthorizationStatus String                @map("recording_authorization_status")
  rawRecordingRagEligible      Boolean               @default(false) @map("raw_recording_rag_eligible")
  recordingStorageRegion       String                @default("me-central1") @map("recording_storage_region")
  takeoverReason               String?               @map("takeover_reason") @db.Text
  startedAt                    DateTime?             @map("started_at")
  completedAt                  DateTime?             @map("completed_at")
  turns                        VoiceAssessmentTurn[]
  createdAt                    DateTime              @default(now()) @map("created_at")
  updatedAt                    DateTime              @updatedAt @map("updated_at")

  @@index([queueItemId, status])
  @@index([callCenterSessionId, status])
  @@index([protocolId, releaseVersion])
  @@index([organizationId])
  @@map("voice_call_sessions")
}

model VoiceAssessmentTurn {
  id                   String                     @id @default(cuid())
  sessionId            String                     @map("session_id")
  session              VoiceCallSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Neither InitialAssessmentQuestion nor ClinicalAudioAsset exist as real
  // per-row vendor tables (IAQ is one free-text blob per Algorithm; audio
  // assets were an app-only concept) - both stay plain, non-relational ids
  // rather than fabricated FKs. No code creates VoiceAssessmentTurn rows today.
  questionId           String                     @map("question_id")
  audioAssetId         String?                    @map("audio_asset_id")
  sequence             Int
  attempt              Int                        @default(1)
  promptTextSnapshot   String                     @map("prompt_text_snapshot") @db.Text
  transcriptText       String?                    @map("transcript_text") @db.Text
  speechStartedAtMs    Int?                       @map("speech_started_at_ms")
  speechEndedAtMs      Int?                       @map("speech_ended_at_ms")
  sttConfidence        Float?                     @map("stt_confidence")
  answerClassification VoiceAnswerClassification? @map("answer_classification")
  structuredAnswer     Json?                      @map("structured_answer")
  interpreterEvidence  Json?                      @map("interpreter_evidence")
  interpreterProvider  String?                    @map("interpreter_provider")
  interpreterModel     String?                    @map("interpreter_model")
  interpreterVersion   String?                    @map("interpreter_version")
  status               VoiceTurnStatus            @default(READY)
  validationStatus     VoiceValidationStatus      @default(PENDING) @map("validation_status")
  nurseCorrectedAnswer Json?                      @map("nurse_corrected_answer")
  validationComment    String?                    @map("validation_comment") @db.Text
  validatedBy          String?                    @map("validated_by")
  validatedAt          DateTime?                  @map("validated_at")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  @@unique([sessionId, sequence, attempt])
  @@index([sessionId, validationStatus])
  @@index([questionId])
  @@map("voice_assessment_turns")
}

model CallCenterEvent {
  id                  String            @id
  callCenterSessionId String            @map("call_center_session_id")
  callCenterSession   CallCenterSession @relation(fields: [callCenterSessionId], references: [id], onDelete: Cascade)
  provider            String
  providerEventId     String            @map("provider_event_id")
  externalCallId      String            @map("external_call_id")
  eventType           String            @map("event_type")
  processStatus       String            @default("RECEIVED") @map("process_status")
  safePayload         Json              @map("safe_payload")
  auditSignature      String            @map("audit_signature")
  failureCode         String?           @map("failure_code")
  occurredAt          DateTime          @map("occurred_at")
  receivedAt          DateTime          @default(now()) @map("received_at")
  processedAt         DateTime?         @map("processed_at")

  @@unique([provider, providerEventId])
  @@index([callCenterSessionId, occurredAt])
  @@index([processStatus, receivedAt])
  @@map("call_center_events")
}

model RagRetrievalEvent {
  id                     String                    @id @default(cuid())
  queueItemId            String?                   @map("queue_item_id")
  queueItem              TriageQueueItem?          @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  sourceType             ClinicalContentSourceType @map("source_type")
  sourceReleaseVersion   String                    @map("source_release_version")
  queryText              String                    @map("query_text") @db.Text
  normalizedReason       String?                   @map("normalized_reason") @db.Text
  extractedKeywords      Json?                     @map("extracted_keywords")
  retrievedSourceIds     Json                      @map("retrieved_source_ids")
  retrievedSnippetHashes Json                      @map("retrieved_snippet_hashes")
  confidence             Float                     @default(0)
  boundaryLabel          String                    @default("APPROVED_CONTENT_ONLY") @map("boundary_label")
  shadowSuggestions      LlmShadowSuggestion[]
  createdAt              DateTime                  @default(now()) @map("created_at")

  @@index([queueItemId, createdAt])
  @@index([sourceType, sourceReleaseVersion])
  @@map("rag_retrieval_events")
}

model LlmShadowSuggestion {
  id                          String                    @id @default(cuid())
  queueItemId                 String?                   @map("queue_item_id")
  queueItem                   TriageQueueItem?          @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  retrievalEventId            String?                   @map("retrieval_event_id")
  retrievalEvent              RagRetrievalEvent?        @relation(fields: [retrievalEventId], references: [id], onDelete: SetNull)
  modelName                   String                    @map("model_name")
  promptVersion               String                    @map("prompt_version")
  corpusVersion               String                    @map("corpus_version")
  extractedReason             Json?                     @map("extracted_reason")
  suggestedKeywords           Json?                     @map("suggested_keywords")
  suggestedProtocolCandidates Json                      @map("suggested_protocol_candidates")
  rationaleSummary            String?                   @map("rationale_summary") @db.Text
  cannotDecideDisposition     Boolean                   @default(true) @map("cannot_decide_disposition")
  requiresNurseReview         Boolean                   @default(true) @map("requires_nurse_review")
  status                      RagShadowStatus           @default(RECORDED)
  comparisonEvents            ProtocolComparisonEvent[]
  blockedOutputs              SafetyBlockedOutput[]
  createdAt                   DateTime                  @default(now()) @map("created_at")

  @@index([queueItemId, createdAt])
  @@index([retrievalEventId])
  @@index([modelName, promptVersion])
  @@map("llm_shadow_suggestions")
}

model NurseSelectionEvent {
  id                      String                 @id @default(cuid())
  queueItemId             String?                @map("queue_item_id")
  queueItem               TriageQueueItem?       @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  selectedProtocolId      String?                @map("selected_protocol_id")
  selectedDispositionCode AcuityDispositionCode? @map("selected_disposition_code")
  selectedCareAdviceIds   Json?                  @map("selected_care_advice_ids")
  selectedByUserId        String                 @map("selected_by_user_id")
  selectedByRole          String                 @map("selected_by_role")
  selectionReason         String?                @map("selection_reason") @db.Text
  sourceStep              String                 @default("QUESTIONS") @map("source_step")
  createdAt               DateTime               @default(now()) @map("created_at")

  @@index([queueItemId, createdAt])
  @@index([selectedByUserId, createdAt])
  @@map("nurse_selection_events")
}

model ProtocolComparisonEvent {
  id                             String                      @id @default(cuid())
  queueItemId                    String?                     @map("queue_item_id")
