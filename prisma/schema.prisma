// Closes IS.61's second half ("notify customers expeditiously") - a
// durable, cross-instance-safe record of a privacy-incident candidate from
// detection through human review, classification, an explicit human
// notification decision, approval, and delivery. Deliberately does NOT
// store revealed field values, PHI, credentials, tokens, or any raw
// sensitive request data - only the operational metadata needed to run and
// evidence the workflow itself.
model PrivacyIncident {
  id                     String    @id @default(cuid())
  organization           String?
  detectionSource        String    @map("detection_source") // e.g. "reveal_anomaly"
  detectedAt             DateTime  @default(now()) @map("detected_at")
  severity               String    @default("unclassified") // unclassified | low | medium | high | critical
  status                 String    @default("detected") // see PrivacyIncidentStatus in code
  assignedOwnerUserId    String?   @map("assigned_owner_user_id")
  privacyImpactStatus    String?   @map("privacy_impact_status") // pending | confirmed_breach | no_impact
  affectedCustomerStatus String?   @map("affected_customer_status") // pending | affected | not_affected
  notificationRequired   Boolean?  @map("notification_required")
  decisionReason         String?   @map("decision_reason")
  decisionByUserId       String?   @map("decision_by_user_id")
  decisionAt             DateTime? @map("decision_at")
  approverUserId         String?   @map("approver_user_id")
  approvalAt             DateTime? @map("approval_at")
  notificationDeadlineAt DateTime? @map("notification_deadline_at")
  notificationSentAt     DateTime? @map("notification_sent_at")
  deliveryStatus         String?   @map("delivery_status") // pending | sent | failed | dry-run
  correlationId          String?   @map("correlation_id")
  evidenceReferences     Json?     @map("evidence_references")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([organization, status])
  @@index([status, notificationDeadlineAt])
  @@index([detectionSource, detectedAt])
  @@map("privacy_incidents")
}

// Closes IS.61's multi-instance requirement: a shared, durable record of
// each reveal-request attempt, used to compute a real org-/user-scoped
// rolling-window count across every Cloud Run instance - the in-memory
// per-instance counter it replaces could not detect a requester
// distributing requests across instances to stay under each instance's
// local threshold. One row per reveal-request attempt (not per-approval),
// deliberately lightweight (no sensitive field values) and self-cleaning
// (old rows outside any realistic window are deleted opportunistically on
// each check, bounding table growth under normal load).
model RevealAnomalyEvent {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  organization String?
  timestamp    DateTime @default(now())

  @@index([userId, timestamp])
  @@index([organization, timestamp])
  @@map("reveal_anomaly_events")
}

// CSQ AR.21's application-level intrusion-detection equivalent (closes
// alongside NFR-118's authentication-anomaly alert policy) - a generic,
// shared, durable counter mirroring RevealAnomalyEvent's exact shape so
// detection is combined across every Cloud Run instance, not per-process.
// signalType distinguishes the kind of security-relevant burst being
// counted (AUTH_FAILURE, MFA_FAILURE, PAM_ELEVATION_DENIED, and any future
// signal) without needing a separate table per signal type. scopeKey is
// whatever dimension that signal is counted against (a userId for
// per-user scoping - never a raw IP/credential value, to keep this table
// free of anything sensitive).
model SecurityAnomalyEvent {
  id           String   @id @default(cuid())
  signalType   String   @map("signal_type")
  scopeKey     String   @map("scope_key")
  organization String?
  timestamp    DateTime @default(now())

  @@index([signalType, scopeKey, timestamp])
  @@index([organization, timestamp])
  @@map("security_anomaly_events")
}

